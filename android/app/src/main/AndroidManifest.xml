<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络权限（Supabase 在线排行榜需要） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 通知权限（喝水提醒） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 振动反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 精确闹钟（喝水提醒准时触发；Android 12+ 需要，targetSdk<34 默认授予） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 设备重启后恢复提醒闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 导出备份到下载目录（仅 Android 8.1/9 需要；Android 10+ 走 MediaStore 免权限） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DrinkWaterWeb"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.DrinkWaterWeb">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 喝水提醒广播接收器（exported=true 才能收到 BOOT_COMPLETED 系统广播；
             REMINDER action 带包名前缀且走显式 PendingIntent，外部无法触发） -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.drinkwater.web.REMINDER" />
            </intent-filter>
            <!-- 开机恢复提醒（exported 需为 true 才能收系统广播，但只允许系统发送） -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 每周一保活广播接收器（App 内部调度，防数据库暂停） -->
        <receiver
            android:name=".KeepAliveReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.drinkwater.web.KEEPALIVE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
